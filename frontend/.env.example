# Public client-side vars
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_MAPPING_PREFIX=/backend
# Optional mappings for extra third-party domains
NEXT_PUBLIC_URL_MAPPINGS=/backend|your-render-service.onrender.com

# Server-side vars used by Next.js API routes (/api/discord/token and /api/discord/me)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional. Leave empty unless you explicitly use one redirect URI and register it in Discord OAuth2 settings.
DISCORD_REDIRECT_URI=
